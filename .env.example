POSTGRES_DB=rescue_alert
POSTGRES_USER=rescue_user
POSTGRES_PASSWORD=change_me_now
POSTGRES_HOST=db
POSTGRES_PORT=5432

SECRET_KEY=django-insecure-dev-only-change-this-before-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Origins allowed to send unsafe (POST/PUT/DELETE) requests, including the
# admin login form. Leave unset in production: settings.py then trusts
# https://<host> for every host in ALLOWED_HOSTS, which is what you want behind
# Cloudflare. Set it only to trust an origin that is not in ALLOWED_HOSTS.
# CSRF_TRUSTED_ORIGINS=https://example.com

# Send session/CSRF cookies over HTTPS only. Defaults to "not DEBUG", so
# production gets them automatically; override for a plain-HTTP staging box.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# HTTPS enforcement -- OFF on purpose, see the long comment in
# backend/config/settings.py. nginx on debian01 listens on port 80 only and its
# shared proxy snippet overwrites Cloudflare's X-Forwarded-Proto with "http",
# so Django never sees a secure request. Turning these on before fixing that
# snippet makes the site redirect forever.
# USE_X_FORWARDED_PROTO=False
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
